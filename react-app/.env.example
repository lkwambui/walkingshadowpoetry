# ---------------------------------------------------------------------------
# Walking Shadow Poetry — storefront environment variables
#
# Copy to `.env` and adjust. Only PUBLIC, non-secret values belong here.
# M-Pesa credentials and other secrets live server-side in the
# `walking-shadow-commerce` WordPress plugin.
# ---------------------------------------------------------------------------

# WordPress content install (stories / journal).
VITE_WORDPRESS_API_URL=https://walkingshadowpoetry.com/blog/wp-json/wp/v2

# WooCommerce Store API (public, customer-facing commerce).
VITE_STORE_API_URL=https://walkingshadowpoetry.com/shop/wp-json/wc/store/v1

# Custom Walking Shadow Commerce plugin REST base (M-Pesa, commissions, newsletter).
VITE_COMMERCE_API_URL=https://walkingshadowpoetry.com/shop/wp-json/walkingshadow/v1

# Absolute site origin used for canonical URLs, Open Graph and JSON-LD.
VITE_SITE_URL=https://walkingshadowpoetry.com

# WooCommerce payment gateway id registered by the plugin. Must match the
# gateway id defined in class-wsc-gateway.php. Override only if you rename it.
VITE_MPESA_GATEWAY_ID=walkingshadow_mpesa

# Read the clearly-labelled local development dataset instead of WooCommerce.
# NEVER enable this in production.
VITE_USE_MOCK_DATA=false
